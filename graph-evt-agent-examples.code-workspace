{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.envFile": "${workspaceFolder}/.env",
    "files.encoding": "utf8",
    "files.exclude": {
      "**/__pycache__": true
    },
    "search.exclude": {
      "data/**": true,
      "results/**": true,
      "results_quick/**": true,
      "reference_results/**": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "0. Install Graph-EVT-agent showcase",
        "type": "shell",
        "command": "python3 -m venv .venv && .venv/bin/python -m pip install --upgrade pip && .venv/bin/python -m pip install -r requirements.txt",
        "windows": {
          "command": "py -3.11 -m venv .venv; .venv\\Scripts\\python -m pip install --upgrade pip; .venv\\Scripts\\python -m pip install -r requirements.txt"
        },
        "problemMatcher": []
      },
      {
        "label": "1. Fetch and verify example data",
        "type": "shell",
        "command": "${command:python.interpreterPath} scripts/fetch_data.py",
        "problemMatcher": []
      },
      {
        "label": "Example: brain (quick)",
        "type": "shell",
        "command": "${command:python.interpreterPath} scripts/run_all.py --quick --only brain",
        "problemMatcher": []
      },
      {
        "label": "Example: aviation (quick)",
        "type": "shell",
        "command": "${command:python.interpreterPath} scripts/run_all.py --quick --only aviation --jobs 1",
        "problemMatcher": []
      },
      {
        "label": "Example: finance (quick)",
        "type": "shell",
        "command": "${command:python.interpreterPath} scripts/run_all.py --quick --only finance",
        "problemMatcher": []
      },
      {
        "label": "2. Smoke test all three examples (~10 min)",
        "type": "shell",
        "command": "${command:python.interpreterPath} scripts/run_all.py --quick",
        "problemMatcher": []
      },
      {
        "label": "3. Run all three Graph-EVT examples (~1 h)",
        "type": "shell",
        "command": "${command:python.interpreterPath} scripts/run_all.py",
        "problemMatcher": []
      },
      {
        "label": "4. Verify reference results",
        "type": "shell",
        "command": "${command:python.interpreterPath} scripts/compare_results.py",
        "problemMatcher": []
      },
      {
        "label": "5. Verify optional research block E",
        "type": "shell",
        "command": "${command:python.interpreterPath} scripts/check_block_e.py",
        "problemMatcher": []
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Данные: скачать и проверить",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/scripts/fetch_data.py",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal"
      },
      {
        "name": "All three Graph-EVT examples (run_all.py)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/scripts/run_all.py",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal"
      },
      {
        "name": "Graph-EVT smoke test (run_all.py --quick)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/scripts/run_all.py",
        "args": [
          "--quick"
        ],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal"
      },
      {
        "name": "Example: brain (src/brain_seeg_pipeline.py)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/src/brain_seeg_pipeline.py",
        "cwd": "${workspaceFolder}/src",
        "console": "integratedTerminal",
        "args": [
          "--data",
          "${workspaceFolder}/../BioMedAI-sEEG-core-of-epilepsy/dataset/sEEG-HFOs-8_cases_derived.npz",
          "--out",
          "${workspaceFolder}/results/brain"
        ],
        "env": {
          "OMP_NUM_THREADS": "1",
          "MKL_NUM_THREADS": "1",
          "OPENBLAS_NUM_THREADS": "1"
        }
      },
      {
        "name": "Example: aviation (src/aviation_cmapss_pipeline.py)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/src/aviation_cmapss_pipeline.py",
        "cwd": "${workspaceFolder}/src",
        "console": "integratedTerminal",
        "args": [
          "--data",
          "${workspaceFolder}/data/CMAPSSData",
          "--out",
          "${workspaceFolder}/results/aviation"
        ],
        "env": {
          "OMP_NUM_THREADS": "1",
          "MKL_NUM_THREADS": "1",
          "OPENBLAS_NUM_THREADS": "1"
        }
      },
      {
        "name": "Example: finance (src/finance_sp500_pipeline.py)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/src/finance_sp500_pipeline.py",
        "cwd": "${workspaceFolder}/src",
        "console": "integratedTerminal",
        "args": [
          "--data",
          "${workspaceFolder}/data",
          "--out",
          "${workspaceFolder}/results/finance"
        ],
        "env": {
          "OMP_NUM_THREADS": "1",
          "MKL_NUM_THREADS": "1",
          "OPENBLAS_NUM_THREADS": "1"
        }
      },
      {
        "name": "Рисунки 57–62 (src/make_figures.py)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/src/make_figures.py",
        "cwd": "${workspaceFolder}/src",
        "console": "integratedTerminal",
        "env": {
          "OMP_NUM_THREADS": "1",
          "MKL_NUM_THREADS": "1",
          "OPENBLAS_NUM_THREADS": "1"
        }
      },
      {
        "name": "Сверка с результатами исследования",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/scripts/compare_results.py",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal"
      },
      {
        "name": "Сверка блока E § 3.11",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/scripts/check_block_e.py",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal"
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.debugpy"
    ]
  }
}
